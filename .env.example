# ======================================================================
#   تنظیمات عامل هوشمند نود هوش مصنوعی (AI Node Agent Config)
#   کافیست این فایل را با نام .env ذخیره کرده و مقادیر را تغییر دهید.
# ======================================================================

# ----------------------------------------------------------------------
# ۱. آدرس سرور مرکزی (Central Gateway URL)
# آدرس IP و پورت 8200 سرور مرکزی شما (مثلاً IP سرور لینوکس در شبکه یا Tailscale)
# ----------------------------------------------------------------------
GATEWAY_URL=http://localhost:8200

# ----------------------------------------------------------------------
# ۲. مسیر فایل آرشیو ایمیج داکر (Docker Image Archive Path)
# اگر فایل vllm-image.tar را روی سیستم دارید، مسیر آن را بنویسید (بدون اینترنت لود می‌شود)
# اگر خالی باشد، اسکریپت خودکار در پوشه پروژه و درایو D جستجو می‌کند.
# ----------------------------------------------------------------------
IMAGE_TAR_PATH=

# ----------------------------------------------------------------------
# ۳. مسیر پوشه وزن‌های مدل هوش مصنوعی (Local Model Weights Path)
# اگر پوشه مدل Qwen را روی هارد دارید، مسیر دقیق آن را وارد کنید (۰ دانلود اینترنتی)
# اگر خالی باشد، اسکریپت خودکار پوشه models و کش هاگینگ فیس را اسکن می‌کند.
# ----------------------------------------------------------------------
LOCAL_MODEL_PATH=

# ----------------------------------------------------------------------
# ۴. نام اختصاصی این نود در سرور مرکزی (Node Identifier)
# یک نام خوانا برای این لپ‌تاپ/سرور (مثلاً: node-mahdi-rtx3050 یا node-ali-rtx4060)
# اگر خالی باشد، به صورت خودکار از نام کامپیوتر تولید می‌شود.
# ----------------------------------------------------------------------
NODE_ID=node-gpu-01

# ----------------------------------------------------------------------
# ۵. پورت اجرای موتور vLLM روی این سیستم (Host Port)
# پیش‌فرض: 8000
# ----------------------------------------------------------------------
VLLM_PORT=8000

# ----------------------------------------------------------------------
# ۶. آدرس IP اختصاصی این نود (Node Reachable API Base)
# آدرسی که سرور مرکزی با آن با این نود صحبت می‌کند (مثلاً http://100.80.1.20:8000)
# اگر خالی بگذارید، اسکریپت خودش خودکار IP فعال این سیستم را پیدا می‌کند.
# ----------------------------------------------------------------------
NODE_API_BASE=

# ----------------------------------------------------------------------
# ۷. توکن هاگینگ فیس (اختیاری - برای مدل‌های محافظت‌شده مثل Llama-3)
# ----------------------------------------------------------------------
HF_TOKEN=

# ----------------------------------------------------------------------
# ۸. حالت خودکار بدون سوال و جواب (Non-Interactive)
# مقدار true یا false. اگر true باشد، تمام مراحل بدون پرسیدن تایید انجام می‌شود.
# ----------------------------------------------------------------------
NON_INTERACTIVE=false
