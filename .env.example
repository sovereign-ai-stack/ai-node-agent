# ==============================================================================
# Sovereign AI Stack - AI Node Agent Production Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Central Control Plane & Gateway Connection
# ------------------------------------------------------------------------------
# Central Registry / Gateway URL where this node will report and register itself.
GATEWAY_URL=http://localhost:8200

# Unique static identifier for this worker node (e.g. node-tehran-gpu-01).
# If left blank, agent will auto-generate from hostname + machine UUID.
NODE_ID=node-worker-01

# Reachable static HTTP URL that the Central Gateway and LiteLLM can call to reach this node.
# IMPORTANT: In production Zero-Trust / corporate networks, set this explicitly
# to the node's static IP or internal DNS name (e.g. http://192.168.1.105:8000).
NODE_API_BASE=http://127.0.0.1:8000

# Shared secret / Bearer authentication token matching REGISTRY_SECRET on Central Gateway.
AUTH_TOKEN=sk-registry-secret-prod-key-2026

# Heartbeat reporting frequency in seconds (reports VRAM, GPU temp, and live throughput).
HEARTBEAT_INTERVAL=15


# ------------------------------------------------------------------------------
# 2. vLLM Engine & Docker Deployment
# ------------------------------------------------------------------------------
# Host port exposed for vLLM OpenAI-compatible REST API.
VLLM_PORT=8000

# Docker container name to be spawned by the agent.
CONTAINER_NAME=vllm-node

# Custom Docker image for vLLM inference runtime.
VLLM_IMAGE=vllm/vllm-openai:latest

# Local .tar archive path for loading vLLM image in Air-Gapped / offline networks.
# IMAGE_TAR_PATH=./vllm-image.tar


# ------------------------------------------------------------------------------
# 3. Model Weights & Offline Storage
# ------------------------------------------------------------------------------
# Local directory containing pre-downloaded Safetensors / GGUF / AWQ model weights.
# The agent prioritizes these weights to avoid redundant downloads.
LOCAL_MODEL_PATH=D:/models

# Hugging Face Token for gated / restricted model access (e.g. Meta Llama 3).
HF_TOKEN=

# Path to custom model catalog JSON (defaults to ./model_catalog.json).
CATALOG_PATH=./model_catalog.json


# ------------------------------------------------------------------------------
# 4. Automation & Execution Policy
# ------------------------------------------------------------------------------
# Set to 'true' for unattended headless boot (Systemd service / Task Scheduler).
# Automatically picks and deploys the #1 benchmark-optimal model without prompt.
NON_INTERACTIVE=false

# Allow deploying on CPU when no NVIDIA CUDA GPU is detected.
FORCE_CPU=false

# Override hardware detection and force a specific tier (e.g. tier-4gb-vram, tier-8gb-vram).
# MODEL_TIER=tier-4gb-vram

# Override served model alias in LiteLLM (e.g. general-model, reasoning-model).
# SERVED_MODEL_NAME=general-model


# ------------------------------------------------------------------------------
# 5. Mesh Overlay Network (Tailscale Zero-Touch VPN)
# ------------------------------------------------------------------------------
# Tailscale Reusable/Ephemeral Auth Key (tskey-auth-...)
# When provided, run.bat / bootstrap will automatically install Tailscale (via winget)
# and silently join the encrypted mesh VPN without user interaction (--unattended).
# This gives the node a static 100.x.y.z IP accessible securely across data centers/NAT.
TAILSCALE_AUTHKEY=

